  <diagram id="specbridge-agent" name="SpecBridge agent (LangGraph, orchestrator + subagents)">
    <mxGraphModel dx="1245" dy="586" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
