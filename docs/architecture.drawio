        <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=18;" value="&lt;b&gt;SpecBridge agent - LangGraph orchestrator and subagents&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1000" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="Ticket URL in, UAT test-case page out. The orchestrator splits the ticket by acceptance criterion; independent criterion workers (subgraphs) search the code and write cases in parallel; merge combines; an independent reviewer checks and sends weak criteria back. Only &lt;b&gt;publish&lt;/b&gt; writes. Details: docs/ARCHITECTURE.md" vertex="1">
          <mxGeometry height="40" width="1290" x="30" y="48" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#666666;" value="&lt;b&gt;Main graph&lt;/b&gt; - LangGraph StateGraph (SpecBridgeState, checkpointed after every node)" vertex="1">
          <mxGeometry height="560" width="1100" x="220" y="100" as="geometry" />
        </mxCell>
