        <mxCell id="c52" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;fontColor=#555555;" value="Needs more than its budget? Returns &lt;b&gt;needs_more&lt;/b&gt; with a reason; the orchestrator grants extra once from the 20% reserve, or accepts a partial result shown as incomplete. Workers never talk to each other." vertex="1">
          <mxGeometry height="60" width="300" x="1000" y="720" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fillColor=#ffffff;" value="&lt;b&gt;State&lt;/b&gt;&lt;br&gt;&lt;b&gt;SpecBridgeState&lt;/b&gt; (main): run_id, mode; ticket; understanding (intent, criteria, screens, questions, risks, testable); brief; work_items[] (criterion slice, seed evidence, budget); results[] (WorkerResult, list reducer); plan (merged cases); review (per criterion ok / gaps); round; budget (tokens, cost cap $0.25, reserve); page; status&lt;br&gt;&lt;br&gt;&lt;b&gt;WorkerState&lt;/b&gt; (private, per subagent): brief, slice, evidence[], messages[], budget, tool_calls, status" vertex="1">
          <mxGeometry height="250" width="340" x="1380" y="88" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fillColor=#ffffff;" value="&lt;b&gt;Context per subagent&lt;/b&gt;&lt;br&gt;1. Shared brief (all workers, read-only, ~1k tokens)&lt;br&gt;2. Private slice: its criterion, matching ticket text, starting evidence, budget&lt;br&gt;3. Private memory: its tool conversation (never shared; kept in the run record)&lt;br&gt;Only WorkerResult leaves a worker.&lt;br&gt;&lt;br&gt;&lt;b&gt;Subagents per ticket&lt;/b&gt;&lt;br&gt;1 per criterion group (max 5) + e2e if 2+ workers; retries only for weak criteria (max 2 rounds). Parallel on cloud LLM; one at a time on local SLM." vertex="1">
          <mxGeometry height="220" width="340" x="1380" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1">
