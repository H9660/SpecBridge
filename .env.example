# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Your Atlassian site, e.g. https://unmanned-rooks.atlassian.net
ATLASSIAN_SITE=
# The email you signed up with
ATLASSIAN_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# Jira project that holds the copied test tickets
JIRA_PROJECT_KEY=SPEC
# Confluence space where SpecBridge writes UAT pages
CONFLUENCE_SPACE_KEY=UAT

# The "brain": llm (cloud, default) or slm (local, later). Profiles are in config/brains.json
BRAIN=llm
# Create at https://openrouter.ai/settings/keys - set a spending limit on the key
OPENROUTER_API_KEY=
# Optional: use another model for one run, e.g. google/gemini-4-argon (blank = config default)
BRAIN_MODEL=

# Where the frozen repos are downloaded (outside OneDrive)
SPECBRIDGE_WORKDIR=C:/specbridge-work

# --- Added in Phase 0 (handoff scaffold) ---
# The agent and judge models are set in config/config.yaml (LiteLLM IDs). Both go through OpenRouter,
# so OPENROUTER_API_KEY above is the only key needed. Only fill these if you call a provider directly:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local embeddings (config/embedder.json). Optional override:
EMBED_MODEL=
