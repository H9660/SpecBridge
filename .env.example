# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Your Atlassian site, e.g. https://unmanned-rooks.atlassian.net
ATLASSIAN_SITE=
# The email you signed up with
ATLASSIAN_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# Jira project that holds the copied test tickets
JIRA_PROJECT_KEY=SPEC
# Confluence space where SpecBridge writes UAT pages
CONFLUENCE_SPACE_KEY=UAT

# The "brain": llm (cloud, default) or slm (local, later). Profiles are in config/brains.json
BRAIN=llm
# Gemini, called directly at Google. Create at https://aistudio.google.com/apikey (free tier, or turn on billing)
GEMINI_API_KEY=
# Optional: use another Gemini model for one run, e.g. gemini-4-argon (blank = config default)
BRAIN_MODEL=

# Where the frozen repos are downloaded (outside OneDrive)
SPECBRIDGE_WORKDIR=C:/specbridge-work

# The Jira "Run SpecBridge" button (scripts/serve.py, docs/DEPLOY_JIRA.md): a long random secret that the Jira
# Automation rule sends in the X-SpecBridge-Secret header. Make one with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
SPECBRIDGE_WEBHOOK_SECRET=
