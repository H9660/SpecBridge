        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "O3-5695",
           "marks": [
            {
             "type": "em"
            }
           ]
          },
          {
           "type": "text",
           "text": " — unify the encounter parsing. Its open [PR reference removed] to be closed; parsing is removed entirely when the shared components are adopted."
          }
         ],
         "attrs": {
          "localId": "b1dd394c2608"
         }
        }
       ]
      },
      {
