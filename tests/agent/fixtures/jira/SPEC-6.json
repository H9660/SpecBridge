       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "O3-5694",
           "marks": [
            {
             "type": "em"
            }
           ]
          },
          {
           "type": "text",
           "text": " — migrate to the shared vitals extension. Its open [PR reference removed] to be closed; vitals handled here via the shared components."
          }
