{
  "default": "llm",
  "brains": {
    "llm": {
      "api": "openai-chat",
      "provider": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "google/gemini-3.8-flash",
      "api_key_env": "OPENROUTER_API_KEY",
      "structured_outputs": true,
      "context_window": 1048576,
      "timeout_seconds": 180,
      "extra_body": {"usage": {"include": true}},
      "extra_headers": {"X-Title": "SpecBridge"}
    },
    "slm": {
      "api": "openai-chat",
      "provider": "ollama",
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5-coder:3b",
      "api_key_env": null,
      "structured_outputs": true,
      "context_window": 32768,
      "timeout_seconds": 900,
      "note": "Not set up yet. The SLM course picks the model; install Ollama and run `ollama pull <model>`."
    }
  }
}
